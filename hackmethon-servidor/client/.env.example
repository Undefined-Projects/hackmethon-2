# ============================================================
#  Cliente — variables de entorno
#
#  Las dos son opcionales. Sin ninguna, el cliente deduce el backend
#  del host por el que se abrió la página (mismo hostname, puerto 4000):
#  es lo que hace funcionar la red local sin tocar nada.
# ============================================================

# Dirección pública de la API. Rellénala SOLO cuando el front y el
# backend no comparten host — es el caso de Vercel, donde deducir el
# host daría `mi-app.vercel.app:4000`, que no existe.
#
#   En Vercel:  Project Settings → Environment Variables
#               VITE_API_URL = https://api.tu-dominio.org
#
# Si tu túnel estrena URL en cada arranque, no hace falta tocar esto ni
# reconstruir: reparte `https://tu-app.vercel.app/?api=<url-del-túnel>`
# y cada navegador recuerda el destino (`?api=reset` lo olvida).
VITE_API_URL=""

# Puerto de la API para el caso de red local. Solo se usa cuando
# VITE_API_URL está vacío.
VITE_API_PORT="4000"
